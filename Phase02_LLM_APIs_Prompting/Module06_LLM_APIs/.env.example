ANTHROPIC_API_KEY=sk-ant-...
# Optional: OmniRoute takes precedence in _openrouter_client.py when its key is set.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=cc/claude-sonnet-4-6
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Alternative to the two keys above: set only this one (from openrouter.ai)
# and every file in this folder will route through OpenRouter to Claude
# instead - see _openrouter_client.py.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
