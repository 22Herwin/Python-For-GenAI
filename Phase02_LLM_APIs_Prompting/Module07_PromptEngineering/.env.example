ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Alternative to the two keys above: set only this one (from openrouter.ai)
# and every file in this folder will route through OpenRouter to Claude
# instead - see _openrouter_client.py.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Or route through a local OmniRoute gateway instead (takes precedence
# over both options above if set):
# OMNIROUTE_API_KEY=...
# OMNIROUTE_MODEL=cc/claude-sonnet-4-6
