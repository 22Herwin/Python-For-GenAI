OPENAI_API_KEY=sk-...

# Alternative: set only this one (from openrouter.ai) and every file in this
# folder will build its chat model through OpenRouter instead - see
# _openrouter_client.py.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o

# Optional backups (used only when OpenRouter fails, e.g. its daily free quota is
# used up), tried in this order: Gemini (free key from aistudio.google.com), then
# Groq (free key from console.groq.com).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
