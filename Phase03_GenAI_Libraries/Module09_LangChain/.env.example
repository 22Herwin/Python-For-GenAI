OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Alternative: set only this one (from openrouter.ai) and every file in this
# folder will use OpenRouter for chat and embeddings instead - see
# _openrouter_client.py. Optional model overrides:
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_OPENAI_MODEL=openai/gpt-4o
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small

# Optional backup (free key from aistudio.google.com): used only when OpenRouter
# fails, e.g. its daily free quota is used up (chat via "auto", and embeddings).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
