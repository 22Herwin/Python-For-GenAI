# Embeddings (optional for ChromaDB demos - they fall back to an offline mock
# embedder when no key is set; required for Pinecone)
OPENAI_API_KEY=sk-...

# Alternative: set only this one (from openrouter.ai) and every file in this
# folder will embed through OpenRouter instead - see _openrouter_client.py.
# OPENROUTER_API_KEY=sk-or-...

# Or route through a local OmniRoute gateway (takes precedence if set) - NOTE:
# needs an "openai" provider configured with real credentials in the OmniRoute
# dashboard first, or embed calls fail with a clear error from OmniRoute itself.
# OMNIROUTE_API_KEY=...

# 11.3 Pinecone (managed service - required for 03_pinecone.py)
PINECONE_API_KEY=pcsk_...

# 11.4 Weaviate (04_weaviate.py) - leave both unset to use a local instance
# (docker run -d -p 8080:8080 -p 50051:50051 cr.weaviate.io/semitechnologies/weaviate:latest),
# or set both to use Weaviate Cloud.
# WEAVIATE_URL=your-cluster.weaviate.cloud
# WEAVIATE_API_KEY=...
