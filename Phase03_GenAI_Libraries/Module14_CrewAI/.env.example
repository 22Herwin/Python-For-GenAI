# Set ONE of these (copy this file to .env and fill it in). If several are set,
# the first match wins: OPENAI > OPENROUTER > ANTHROPIC.
# OPENAI_API_KEY=sk-...

# Alternative: set only this one (from openrouter.ai) and every file in this
# folder will run its crews through OpenRouter instead - see _openrouter_client.py.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o

# Optional backups (used only when OpenRouter fails, e.g. its daily free quota is
# used up), tried in this order: Groq (free key from console.groq.com), then Gemini
# (free key from aistudio.google.com). Groq comes first because agents replay earlier
# tool calls and Gemini 3.x rejects that over the OpenAI-compatible API.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# Or Anthropic directly (uses crewai.LLM with an "anthropic/..." model string).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# CrewAI asks to share an execution trace after every kickoff; the helper turns that
# off by default. Set to true to opt in.
# CREWAI_TRACING_ENABLED=true
