# Set ONE of these (copy this file to .env and fill it in). If several are set,
# the first match wins: OMNIROUTE > OPENAI > OPENROUTER > ANTHROPIC.
# OPENAI_API_KEY=sk-...

# Alternative: set only this one (from openrouter.ai) and every file in this
# folder will run its crews through OpenRouter instead - see _openrouter_client.py.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o

# Or route through a local OmniRoute gateway (takes precedence if set).
# OMNIROUTE_API_KEY=...
# OMNIROUTE_MODEL=cc/claude-sonnet-4-6

# Or Anthropic directly (uses crewai.LLM with an "anthropic/..." model string).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: build agents with crewai.LLM instead of langchain_openai.ChatOpenAI.
# CREWAI_LLM_STYLE=native
