OPENAI_API_KEY=sk-...

# Alternative: set only this one (from openrouter.ai) and every file in this
# folder will use OpenRouter instead - see _openrouter_client.py. Needs
# `pip install llama-index-llms-openai-like llama-index-embeddings-openai-like`.
# Models can be overridden (defaults shown):
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small

# Or route through a local OmniRoute gateway (takes precedence if set) - NOTE:
# needs an "openai" provider configured with real credentials in the OmniRoute
# dashboard first for embeddings, or embed calls fail with a clear error from
# OmniRoute itself.
# OMNIROUTE_API_KEY=...
# OMNIROUTE_MODEL=cc/claude-sonnet-4-6
# OMNIROUTE_EMBEDDING_MODEL=openai/text-embedding-3-small

# With NO key set, every file falls back to an offline mock LLM + hashing
# embeddings so the logic still runs (answers are extractive, not generated).
