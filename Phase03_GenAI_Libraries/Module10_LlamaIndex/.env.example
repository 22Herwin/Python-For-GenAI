OPENAI_API_KEY=sk-...

# Alternative: set only this one (from openrouter.ai) and every file in this
# folder will use OpenRouter instead - see _openrouter_client.py. Needs
# `pip install llama-index-llms-openai-like llama-index-embeddings-openai-like`.
# Models can be overridden (defaults shown):
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small

# Optional backups (used only when OpenRouter fails, e.g. its daily free quota
# is used up), tried in this order: Gemini (free key from aistudio.google.com;
# chat and embeddings), then Groq (free key from console.groq.com; chat only,
# Groq has no embeddings).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# With NO key set, every file falls back to an offline mock LLM + hashing
# embeddings so the logic still runs (answers are extractive, not generated).
